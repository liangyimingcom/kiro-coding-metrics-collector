# ============================================================
# kiro-dashboard 环境变量配置示例 (RDS PostgreSQL 版)
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# --- 数据库连接（必须）：RDS PostgreSQL ---
DB_HOST=kiro-metrics-pg.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=kiro
DB_USER=kiroadmin
DB_PASSWORD=<your-db-password>
# RDS 建议开启 TLS；本演示用 require（TLS 加密但不校验 CA）
DB_SSL=require
# 连接池上限（可选）
# DB_POOL_MAX=10
# 或用单一连接串替代以上 DB_* （二选一）
# DATABASE_URL=postgres://kiroadmin:<password>@host:5432/kiro

# --- AWS 基础配置 ---
AWS_REGION=us-east-1
# 在 EC2 上使用实例角色(Instance Profile)时无需填写静态密钥；
# SDK 会自动走实例角色 / 默认凭据链。本地调试才需要下面两行：
# AWS_ACCESS_KEY_ID=<your-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# --- IAM Identity Center（可选：用户同步功能需要）---
IDENTITY_STORE_ID=d-xxxxxxxxxx

# --- S3 Kiro User Activity Report（可选：credit 同步功能需要）---
KIRO_S3_BUCKET=my-kiro-bucket
KIRO_S3_PREFIX=kiro-logs/

# --- AWS 账号（可选：credit 同步功能需要）---
KIRO_ACCOUNT_ID=123456789012

# --- 可选：服务端口 ---
# INGEST_PORT=80
# DASHBOARD_PORT=3500
